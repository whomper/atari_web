[Unit]
Description=Falcon IMAP proxy (log + Content-Type rewrite)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/falcon-imap/falcon_imap_logproxy.py --listen 192.168.68.126 --port 143 --rewrite --hebrew-mode glyph --glyph-width 60 --hebrew-words /opt/falcon-imap/hebrew_words.txt
Restart=on-failure
RestartSec=5s
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
